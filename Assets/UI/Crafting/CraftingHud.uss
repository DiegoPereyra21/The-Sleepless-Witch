.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Alegreya,Jim_Nightshade,Noto_Serif/Alegreya/Alegreya-Italic-VariableFont_wght.ttf?fileID=12800000&guid=abb940bfb20575541b04e7e3299b35c1&type=3#Alegreya-Italic-VariableFont_wght");
}

.recipe {
    position: absolute;
    right: 20px;
    top: 20px;
    width: 340px;
    padding: 10px 14px 12px 14px;
    background-color: rgba(31, 0, 2, 0.86);
    border-width: 3px;
    border-color: rgba(255, 214, 74, 0.7);
    border-radius: 18px;
}

.recipe__bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.recipe__header {
    flex-grow: 1;
    font-size: 22px;
    color: rgb(236, 217, 226);
    -unity-text-align: middle-center;
}

.recipe__arrow {
    width: 38px;
    height: 34px;
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(0, 0, 0);
    border-width: 0;
    border-radius: 10px;
}

.recipe__arrow:hover {
    background-color: rgb(63, 43, 89);
}

.recipe__title {
    margin-top: 4px;
    margin-bottom: 6px;
    font-size: 27px;
    color: rgb(255, 214, 74);
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.row {
    flex-direction: row;
    align-items: flex-start;
}

.row__mark {
    width: 32px;
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.row__text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 20px;
    white-space: normal;
    color: rgb(255, 255, 255);
}

.row--done > Label {
    color: rgb(156, 240, 122);
}

.row--missing {
    opacity: 0.45;
}

.row--wrong > Label {
    color: rgb(255, 128, 110);
}

.tooltip {
    position: absolute;
    padding: 6px 14px;
    font-size: 26px;
    color: rgb(255, 255, 255);
    background-color: rgba(20, 13, 31, 0.9);
    border-width: 2px;
    border-color: rgba(255, 214, 74, 0.7);
    border-radius: 10px;
}
