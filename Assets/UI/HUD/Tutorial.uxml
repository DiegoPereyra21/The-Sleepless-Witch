<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Tutorial.uss" />
    <ui:VisualElement name="TutorialAnchor" picking-mode="Ignore" class="tutorial-anchor">
        <ui:VisualElement name="TutorialPanel" class="tutorial" style="display: none;">
            <ui:Label text="Tutorial" name="TutorialName" class="tutorial__title" />
            <ui:Label text="Usa ASDW para moverte y E para interactuar con los objetos del ambiente" name="TutorialText" class="tutorial__text" />
            <ui:Button text="Siguiente" name="NextButton" class="tutorial__next" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
